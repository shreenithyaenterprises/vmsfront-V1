# API BASE URL FOR FRONTEND
# For local development or reverse proxy (works on any IP/localhost/port automatically):
VITE_API_BASE_URL=/api

# Proxy target for Vite dev server (where requests to /api are forwarded locally)
VITE_API_PROXY_TARGET=http://localhost:5002

# Optional custom UI port (defaults to 5173):
# VITE_PORT=5173

# For direct remote API (if not using proxy):
# VITE_API_BASE_URL=https://api.yourdomain.com/api
